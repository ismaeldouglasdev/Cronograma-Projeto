# Database URLs (preencha com suas credenciais)
DATABASE_URL=postgresql://user:password@host:port/database
PG_URL=postgresql://user:password@host:port/database

# JWT — usado para assinar tokens de autenticação.
# Se ausente, é derivado de DATABASE_URL (não recomendado em produção).
JWT_SECRET=troque-por-uma-string-aleatoria-longa

# MIGRATION_SECRET — protege endpoints administrativos (/admin/*, /coins/add).
# Se vazio, endpoints admin ficam bloqueados.
MIGRATION_SECRET=troque-por-outra-string-aleatoria

# Google OAuth — crie o client (Web application) em
# https://console.cloud.google.com/apis/credentials e autorize o redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
APP_URL=http://localhost:8000

# Resend — email de verificação de conta e redefinição de senha.
# Sem a chave (dev/teste), o register auto-verifica como antes.
RESEND_API_KEY=
EMAIL_FROM=Cronograma <onboarding@resend.dev>
