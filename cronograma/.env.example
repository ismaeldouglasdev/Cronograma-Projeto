# Database URLs (preencha com suas credenciais)
DATABASE_URL=postgresql://user:password@host:port/database
PG_URL=postgresql://user:password@host:port/database

# JWT — OBRIGATÓRIO em todos os ambientes (produção e desenvolvimento).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Se ausente, em dev usa derivado de DATABASE_URL (warning); em produção FALHA.
JWT_SECRET=troque-por-uma-string-aleatoria-longa

# MIGRATION_SECRET — protege endpoints administrativos (/admin/*, /coins/add).
# Se vazio, endpoints admin ficam bloqueados.
MIGRATION_SECRET=troque-por-outra-string-aleatoria

# Google OAuth — crie o client (Web application) em
# https://console.cloud.google.com/apis/credentials e autorize o redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
APP_URL=http://localhost:8000

# Resend — email de verificação de conta e redefinição de senha.
# Sem a chave (dev/teste), o register auto-verifica como antes.
RESEND_API_KEY=
EMAIL_FROM=Cronograma <onboarding@resend.dev>

# Rate Limiter IP Resolution — headers confiáveis para identificar IP real.
# Ordem de prioridade: cf-connecting-ip (Cloudflare), x-real-ip (nginx/proxy).
# RATE_LIMIT_TRUSTED_HEADERS=cf-connecting-ip,x-real-ip
# Se True, ignora IPs privados (RFC1918) nos headers e cai no peer TCP.
# RATE_LIMIT_REJECT_PRIVATE_IPS=true

# CSP frame-src — domínios permitidos para iframes (além de 'self').
# CSP_FRAME_SRC=https://ismaeldouglasdev.github.io
